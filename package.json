{
  "name": "kanbi",
  "version": "3.2.0",
  "description": "AI-powered Kanban task management SaaS kanbi transforms notes into organized boards in seconds with workload analysis, burnout prevention, and integrations.",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:lockfile": "pnpm install --frozen-lockfile"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.9.0",
    "isomorphic-dompurify": "^3.0.0",
    "jspdf": "^4.2.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.475.0",
    "next": "16.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.8",
    "stripe": "^20.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.4.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^1.6.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^1.6.1"
  }
}
